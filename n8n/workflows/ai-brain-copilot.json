    {
      "parameters": {
        "jsCode": "const raw = ($input.first().json.text || $input.first().json.output || '').toString();\nlet parsed = { should_save: false };\ntry {\n  const cleaned = raw.trim().replace(/^```json/i, '').replace(/^```/, '').replace(/```$/, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { should_save: false, error: 'parse_failed', raw };\n}\nreturn [{ json: parsed }];"
      },
