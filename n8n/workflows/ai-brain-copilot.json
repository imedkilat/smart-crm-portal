    {
      "parameters": {
        "jsCode": "const LF = String.fromCharCode(10);\nconst body = $('Validate Request').first().json.body || {};\n\nfunction rows(nodeName) {\n  let out = [];\n  try {\n    out = $(nodeName).all();\n  } catch (e) {\n    out = [];\n  }\n  return out\n    .map(i => (i && i.json) ? i.json : {})\n    .filter(r => r && Object.keys(r).length > 0);\n}\n\nconst leadRows = rows('Get Active Workspace Leads').filter(r => r.id || r.public_id);\nconst taskRows = rows('Get Workspace Tasks').filter(r => r.public_id || r.id || r.lead_id);\nconst stageRows = rows('Get Pipeline Stages').filter(r => r.id || r.name);\nconst pipelineRows = rows('Get Pipelines').filter(r => r.id || r.name);\nconst weeklyRows = rows('Get Latest Weekly Report');\nconst insightRows = rows('Get Latest Insight');\nconst memoryRows = rows('Get Active Memories').filter(r => r.content || r.id);\n\nfunction temp(l) {\n  const s = String(l.category || '').toLowerCase();\n  return (s === 'hot' || s === 'warm' || s === 'cold') ? s : null;\n}\nlet hot = 0, warm = 0, cold = 0, unclassified = 0;\nfor (const l of leadRows) {\n  const t = temp(l);\n  if (t === 'hot') hot++;\n  else if (t === 'warm') warm++;\n  else if (t === 'cold') cold++;\n  else unclassified++;\n}\n\nconst leads = leadRows.map(l => ({\n  id: l.id ?? null,\n  public_id: l.public_id ?? null,\n  name: l.name ?? l.full_name ?? null,\n  budget: l.budget ?? null,\n  currency_code: l.currency_code ?? null,\n  category: l.category ?? null,\n  intent: l.intent ?? null,\n  routing_status: l.routing_status ?? null,\n  pipeline_stage_id: l.pipeline_stage_id ?? null,\n  created_at: l.created_at ?? null,\n}));\n\nconst tasks = taskRows.map(t => ({\n  public_id: t.public_id ?? null,\n  lead_id: t.lead_id ?? null,\n  title: t.title ?? null,\n  status: t.status ?? null,\n  priority: t.priority ?? null,\n  due_at: t.due_at ?? null,\n  completed_at: t.completed_at ?? null,\n}));\n\nconst stages = stageRows.map(s => ({\n  id: s.id ?? null,\n  name: s.name ?? null,\n  position: s.position ?? null,\n  stage_type: s.stage_type ?? null,\n}));\n\nconst pipelines = pipelineRows.map(p => ({\n  id: p.id ?? null,\n  name: p.name ?? null,\n  is_default: p.is_default ?? null,\n}));\n\nlet weekly = null;\nif (weeklyRows.length) {\n  const w = weeklyRows[0];\n  weekly = {\n    id: w.id ?? null,\n    created_at: w.created_at ?? null,\n    period_start: w.period_start ?? null,\n    period_end: w.period_end ?? null,\n    total_leads: w.total_leads ?? null,\n    total_tasks: w.total_tasks ?? null,\n    totals: w.totals ?? null,\n    changes: w.changes ?? null,\n    ai_summary: w.ai_summary ?? w.summary ?? null,\n  };\n}\n\nlet insight = null;\nif (insightRows.length) {\n  const n = insightRows[0];\n  const bullets = [n.insight_1, n.insight_2, n.insight_3].filter(Boolean);\n  const recs = [n.recommendation_1, n.recommendation_2, n.recommendation_3].filter(Boolean);\n  insight = {\n    id: n.id ?? null,\n    created_at: n.created_at ?? null,\n    text: bullets.length ? bullets.join(' ') : (n.ai_commentary ?? null),\n    recommendations: recs.length ? recs : null,\n  };\n}\n\nconst memories = memoryRows.slice(0, 12).map(m => ({\n  content: m.content ?? null,\n  memory_type: m.memory_type ?? null,\n  scope_type: m.scope_type ?? null,\n  scope_key: m.scope_key ?? null,\n  confidence: m.confidence ?? null,\n  similarity: m.similarity ?? null,\n}));\n\nconst counts = {\n  leads: leads.length,\n  tasks: tasks.length,\n  stages: stages.length,\n  pipelines: pipelines.length,\n  memories: memories.length,\n  weekly_report: weekly ? 1 : 0,\n  insight: insight ? 1 : 0,\n  lead_temperature: { hot, warm, cold, unclassified },\n};\n\nconst context = {\n  workspace_id: body.workspace_id,\n  counts,\n  leads,\n  tasks,\n  stages,\n  pipelines,\n  weekly_report: weekly,\n  insight,\n  memories,\n};\n\nconst instructions = [\n  'You are the Smart CRM AI Brain, a copilot for a single CRM workspace.',\n  'Answer ONLY from the JSON CRM CONTEXT below. It is scoped to the current workspace and is the sole source of truth.',\n  'Distinguish clearly between AI lead QUALITY (Hot/Warm/Cold, from lead_temperature and intent) and the SALES PIPELINE STAGE (pipeline_stage_id / stages). They are different concepts — never conflate them.',\n  'Never invent counts, names, numbers, or facts. Use only values present in the context. The counts object is authoritative for totals.',\n  'If tasks, weekly_report, insight, or memories are empty or null, say so honestly instead of guessing.',\n  'If the user asks for data that is not present in this CRM context, state plainly that it is outside the available CRM context.',\n  'memories are ranked by semantic similarity to the question (see similarity, 0-1). Treat them as secondary background; current CRM data (leads, tasks, stages, pipelines) takes precedence whenever they conflict.',\n  'Do not expose internal UUIDs (id fields) unless the user explicitly asks for them; refer to records by name or public_id.',\n  'Give concise, actionable answers.',\n].join(LF);\n\nconst prompt = instructions + LF + LF + 'CRM CONTEXT (JSON):' + LF + JSON.stringify(context, null, 2) + LF + LF + 'User question: ' + (body.question || '');\n\nconst contextSnapshot = {\n  counts,\n  sources: {\n    leads: leads.length,\n    tasks: tasks.length,\n    stages: stages.length,\n    pipelines: pipelines.length,\n    memories: memories.length,\n    weekly_report_id: weekly ? weekly.id : null,\n    weekly_report_created_at: weekly ? weekly.created_at : null,\n    latest_insight_id: insight ? insight.id : null,\n    latest_insight_created_at: insight ? insight.created_at : null,\n  },\n  scope_type: body.scope_type ?? null,\n  scope_key: body.scope_key ?? null,\n  generated_at: new Date().toISOString(),\n};\n\nreturn [{ json: {\n  prompt,\n  question: body.question,\n  conversation_id: body.conversation_id,\n  workspace_id: body.workspace_id,\n  user_id: body.user_id,\n  model: 'gemini-2.5-flash',\n  context_snapshot: JSON.stringify(contextSnapshot),\n} }]"
      },
